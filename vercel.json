{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/walkthrough-v1/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/walkthrough", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" }
  ]
}
